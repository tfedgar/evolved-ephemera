<header class="site-header">
  <nav class="site-container navigation" aria-label="Main navigation">
    <a href="/" class="brand" aria-label="Coach Edgar, home">
      <span class="brand-name">Coach Edgar<span class="brand-dot" aria-hidden="true">.</span></span>
      <span class="brand-description">Health &amp; Performance</span>
    </a>
    <button class="menu-toggle" id="menu-toggle" type="button" aria-controls="navigation-links" aria-expanded="false" hidden>
      <span class="menu-label">Menu</span>
      <span class="menu-glyph" aria-hidden="true"><span></span><span></span></span>
    </button>
    <div class="navigation-links" id="navigation-links">
      <a href="/#coaching">Coaching</a>
      <a href="/#programs">Programs &amp; pricing</a>
      <a href="/#about">About Edgar</a>
      <a href="/#questions">Questions</a>
      <a href="/#contact" class="site-button nav-booking">Request a call</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const links = document.querySelector<HTMLElement>('#navigation-links');
  const mobile = window.matchMedia('(max-width: 960px)');

  if (toggle && links) {
    const setMenu = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      links.hidden = mobile.matches && !open;
    };
    const syncMenu = () => {
      toggle.hidden = !mobile.matches;
      setMenu(false);
    };
    syncMenu();
    mobile.addEventListener('change', syncMenu);
    toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
    links.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (mobile.matches && event.target instanceof Node && !toggle.contains(event.target) && !links.contains(event.target)) setMenu(false);
    });
  }
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 30; background: var(--color-page); border-bottom: 1px solid var(--color-line); }
  .navigation { display: flex; align-items: center; justify-content: space-between; gap: 32px; min-height: 97px; }
  .brand { display: inline-flex; flex-direction: column; text-decoration: none; line-height: 1.25; flex-shrink: 0; }
  .brand-name { font-size: 1.55rem; font-weight: 600; letter-spacing: -0.04em; }
  .brand-dot { color: var(--color-action); }
  .brand-description { margin-top: 3px; font-size: 0.72rem; color: var(--color-muted); letter-spacing: 0.01em; }
  .navigation-links { display: flex; align-items: center; gap: 33px; }
  .navigation-links > a { font-size: 0.9rem; font-weight: 500; text-decoration: none; }
  .navigation-links > a:not(.site-button):hover { color: var(--color-action); }
  .nav-booking { min-height: 44px; padding: 11px 21px; margin-left: 4px; }
  .menu-toggle { background: transparent; border: 1px solid var(--color-line); border-radius: 4px; padding: 10px 12px; display: flex; align-items: center; gap: 12px; font-size: 0.9rem; min-height: 44px; }
  .menu-glyph { width: 17px; display: flex; flex-direction: column; gap: 5px; }
  .menu-glyph span { height: 1px; width: 100%; background: var(--color-ink); transition: transform 160ms ease; }
  [aria-expanded="true"] .menu-glyph span:first-child { transform: translateY(3px) rotate(45deg); }
  [aria-expanded="true"] .menu-glyph span:last-child { transform: translateY(-3px) rotate(-45deg); }
  @media (max-width: 900px) { .navigation-links { gap: 22px; } }
  @media (max-width: 960px) {
    .navigation { min-height: 82px; flex-wrap: wrap; gap: 0; }
    .brand-name { font-size: 1.4rem; }
    .brand-description { font-size: 0.68rem; }
    .navigation-links { width: 100%; display: flex; flex-direction: column; align-items: stretch; gap: 0; padding: 10px 0 22px; border-top: 1px solid var(--color-line); }
    .navigation-links > a { padding: 13px 0; }
    .navigation-links > .nav-booking { margin: 10px 0 0; padding: 13px 20px; }
  }
</style>
