---
import { COACHING_PLANS } from '../lib/coaching-plans';
import { resolveInquiryCommitment } from '../lib/inquiry';

const commitment = resolveInquiryCommitment(Astro.url.search);
---

<section class="contact-section site-section" id="contact" aria-labelledby="contact-heading">
  <div class="site-container contact-layout">
    <div class="contact-intro">
      <span class="section-kicker">Arrange a conversation</span>
      <h2 id="contact-heading">Let's find a<br />practical way <br />forward.</h2>
      <p class="section-lead">Tell me what you'd like to change. We'll talk about your goals, your week and whether coaching is a good fit.</p>
      <p class="request-note">Start with a brief inquiry or email me directly. We'll arrange a one-to-one conversation. You can keep the details general until we've agreed how to work together.</p>
      <div class="direct-contact"><span>Prefer email?</span><a href="mailto:info@coachedgar.com">info@coachedgar.com</a></div>
    </div>
    <div class="inquiry-panel">
      <h3>Request a call.</h3>
      <p>A name, email and broad starting point are enough.</p>
      <form action="https://formspree.io/f/xjkogark" method="POST" data-inquiry-form aria-describedby="inquiry-status">
        <div class="form-field"><label for="inquiry-name">Your name</label><input type="text" id="inquiry-name" name="full-name" autocomplete="name" required maxlength="120" /></div>
        <div class="form-field"><label for="inquiry-email">Email address</label><input type="email" id="inquiry-email" name="email" autocomplete="email" required maxlength="254" /></div>
        <div class="form-field"><label for="inquiry-interest">What would you like to talk about?</label><select id="inquiry-interest" name="service-interest"><option value="general-coaching">Health &amp; performance</option><option value="trt-education">TRT alongside medical care</option><option value="peptide-education">Peptide education</option><option value="brain-health">Brain health habits</option><option value="healthy-aging">Healthy aging</option><option value="harm-reduction-education">Steroid harm reduction</option><option value="not-sure">I'm not sure yet</option></select></div>
        <div class="form-field"><label for="inquiry-commitment">Initial minimum commitment <span>(optional)</span></label><select id="inquiry-commitment" name="commitment-interest" aria-describedby="inquiry-commitment-hint"><option value="" selected={commitment === ''}>No preference</option>{COACHING_PLANS.map(plan => <option value={plan.id} selected={commitment === plan.id}>{plan.months} months · ${plan.monthlyUsd} USD/mo</option>)}</select><p id="inquiry-commitment-hint" class="field-hint">This is an interest to discuss, not an enrollment or agreement to pay.</p></div>
        <div class="form-field"><label for="inquiry-goals">A little about your goals <span>(optional)</span></label><textarea id="inquiry-goals" name="broad-goals" rows="3" maxlength="1500" aria-describedby="inquiry-boundary"></textarea><p id="inquiry-boundary" class="field-hint">Keep this general. Please don't include medical histories, laboratory results or drug regimens.</p></div>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
        <button type="submit" class="site-button inquiry-submit">Request a call</button>
        <p id="inquiry-status" class="inquiry-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
        <p class="form-privacy">Your inquiry is sent through Formspree so I can respond. It does not subscribe you to marketing emails. Read how your information is handled in the <a href="/privacy">privacy policy</a>.</p>
      </form>
    </div>
  </div>
</section>

<script>
  import { createInquirySubmission, resolveInquiryCommitment } from '../lib/inquiry';

  const form = document.querySelector<HTMLFormElement>('[data-inquiry-form]');
  const status = form?.querySelector<HTMLElement>('#inquiry-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const commitment = form?.querySelector<HTMLSelectElement>('#inquiry-commitment');
  let commitmentSearch = window.location.search;

  if (form && status && button && typeof window.fetch === 'function') {
    const fields = form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea');
    const originalDisabled = new Map([...fields].map(field => [field, field.disabled] as const));
    let locked = false;
    const submission = createInquirySubmission({
      action: form.action,
      send: window.fetch.bind(window),
      onState: state => {
        const pending = state.status === 'pending';
        const accepted = state.status === 'accepted';
        locked = pending || accepted;
        fields.forEach(field => { field.disabled = locked || originalDisabled.get(field)!; });
        form.setAttribute('aria-busy', String(pending));
        button.disabled = locked;
        button.textContent = pending ? 'Submitting…' : accepted ? 'Request submitted' : 'Try again';
        status.dataset.state = state.status;
        status.textContent = state.message;
        if (!pending) status.focus({ preventScroll: true });
      },
    });
    form.addEventListener('submit', event => {
      event.preventDefault();
      if (locked || !form.reportValidity()) return;
      // Capture first: disabled controls are omitted from native FormData.
      const body = new FormData(form);
      void submission.submit(body);
    });

    window.addEventListener('popstate', () => {
      const search = window.location.search;
      // A load-time or fragment-only event must not overwrite restored edits.
      if (!commitment || search === commitmentSearch) return;
      commitmentSearch = search;
      if (!locked) commitment.value = resolveInquiryCommitment(search);
    });

    // Choosing another rate on this page should retain the visitor's typed inquiry.
    document.querySelectorAll<HTMLAnchorElement>('a[data-inquiry-program]').forEach(link => {
      link.addEventListener('click', event => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || !commitment) return;
        const destination = new URL(link.href);
        const selected = resolveInquiryCommitment(destination.search);
        if (!selected || destination.origin !== window.location.origin || destination.pathname !== window.location.pathname) return;
        event.preventDefault();
        if (locked) { status.focus({ preventScroll: true }); return; }
        commitment.value = selected;
        history.pushState(null, '', destination);
        commitmentSearch = destination.search;
        document.getElementById('contact')?.scrollIntoView();
        commitment.focus({ preventScroll: true });
      });
    });
  }
</script>

<style>
  .contact-section { background: var(--color-panel); }
  .contact-layout { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: 110px; align-items: start; }
  .contact-intro h2 { font-size: clamp(2.7rem, 4.7vw, 4rem); }
  .contact-intro .section-lead { max-width: 370px; margin-top: 28px; font-size: 1.05rem; }
  .request-note { color: var(--color-muted); font-size: 0.9rem; max-width: 345px; margin-top: 24px; }
  .direct-contact { display: flex; flex-direction: column; align-items: start; gap: 3px; margin-top: 46px; font-size: 0.95rem; }
  .direct-contact span { color: var(--color-muted); font-size: 0.8rem; }
  .direct-contact a { font-weight: 500; }
  .direct-contact a:hover { color: var(--color-action); }
  .inquiry-panel { background: var(--color-white); padding: 35px; border-radius: 8px; }
  .inquiry-panel h3 { font-size: 1.5rem; }
  .inquiry-panel > p { color: var(--color-muted); font-size: 0.9rem; margin-top: 9px; }
  form { margin-top: 25px; }
  .form-field + .form-field { margin-top: 18px; }
  label { display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 7px; }
  label span { font-weight: 400; color: var(--color-muted); }
  input, select, textarea { width: 100%; border: 1px solid var(--color-input-line); border-radius: 3px; background: var(--color-white); padding: 11px 12px; color: var(--color-ink); font-size: 1rem; line-height: 1.5; }
  input, select { min-height: 46px; }
  textarea { resize: vertical; min-height: 100px; }
  input:focus, textarea:focus, select:focus { border-color: var(--color-action); }
  .form-field :disabled { opacity: 1; background: var(--color-panel); color: var(--color-ink); -webkit-text-fill-color: var(--color-ink); cursor: default; }
  .field-hint, .form-privacy { color: var(--color-muted); font-size: 0.875rem; line-height: 1.65; }
  .field-hint { margin-top: 8px; }
  .inquiry-submit { width: 100%; min-height: 49px; margin-top: 22px; font-size: 0.9rem; }
  .inquiry-submit:disabled { cursor: default; opacity: 0.72; }
  .inquiry-status { margin-top: 16px; padding: 12px 14px; border: 1px solid var(--color-line); border-radius: 3px; background: var(--color-panel); color: var(--color-ink); font-size: 0.82rem; line-height: 1.65; }
  .inquiry-status:empty { margin: 0; padding: 0; border: 0; }
  .inquiry-status[data-state="provider-error"], .inquiry-status[data-state="network-error"] { border-color: var(--color-muted); }
  .form-privacy { margin-top: 13px; }
  .form-privacy a:hover { color: var(--color-action); }
  @media (max-width: 1050px) { .contact-layout { gap: 60px; } .inquiry-panel { padding: 28px; } }
  @media (max-width: 760px) { .contact-layout { grid-template-columns: 1fr; gap: 40px; } .contact-intro h2 { font-size: 3rem; } .contact-intro h2 br:last-child { display: none; } .contact-intro .section-lead { max-width: 510px; } .direct-contact { margin-top: 28px; } }
  @media (max-width: 400px) { .inquiry-panel { padding: 23px; } .contact-intro h2 { font-size: 2.8rem; } }
</style>
