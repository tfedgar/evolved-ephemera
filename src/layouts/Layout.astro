---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
}

const {
  title,
  description = "Discreet health and performance coaching with Thomas Edgar. Practical plans, weekly check-ins and personal support around demanding work and life outside it.",
  noindex = false,
  canonical,
  image = "/brand/coach-edgar-preview.jpg",
  imageAlt = "Coach Edgar — Health & Performance. Strength for your life. Presence for your family. One-to-one coaching with Thomas Edgar.",
  imageWidth = 1200,
  imageHeight = 630,
  type = "website",
  publishedTime,
  modifiedTime,
  author = "Coach Edgar",
} = Astro.props;
const siteUrl = Astro.site ?? new URL('https://www.coachedgar.com');
const canonicalPath = new URL(canonical ?? Astro.url.pathname, siteUrl).pathname;
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const previewImage = new URL(image, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F6F3ED" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href="/fonts/instrument-sans/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=4" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=4" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Coach Edgar — Health & Performance" />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && author && <meta property="article:author" content={author} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>
