---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import LandingHero from '../components/LandingHero.astro';
import CoachingServices from '../components/CoachingServices.astro';
import SexualWellbeing from '../components/SexualWellbeing.astro';
import CoachingProcess from '../components/CoachingProcess.astro';
import AboutCoach from '../components/AboutCoach.astro';
import CoachingPricing from '../components/CoachingPricing.astro';
import CoachingQuestions from '../components/CoachingQuestions.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Coach Edgar — Health & Performance Coaching"
  description="Discreet, one-to-one coaching for high-performing individuals. Strength, focus, nutrition, sleep, recovery and long-term health in one personal plan."
  canonical="https://www.coachedgar.com/"
>
  <Navigation />
  <main id="main-content" tabindex="-1">
    <LandingHero />
    <CoachingServices />
    <SexualWellbeing />
    <CoachingProcess />
    <AboutCoach />
    <CoachingPricing />
    <CoachingQuestions />
    <ContactSection />
  </main>
  <Footer />
</Layout>
