---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { entry: post },
  }));
}

type Props = { entry: CollectionEntry<'blog'>; };
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout
  title={`${entry.data.title} | Coach Edgar archive`}
  description={entry.data.description}
  noindex={true}
>
  <Navigation />
  <main id="main-content" class="article-main">
    <article class="article-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog/">Article archive</a>
      </nav>
      <header>
        <p class="page-kicker">Archived topic · Updated 14 October 2026</p>
        <h1>{entry.data.title}</h1>
        <p class="article-intro">{entry.data.excerpt}</p>
        <p class="article-date">Originally published <time datetime={entry.data.publishDate.toISOString()}>{entry.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time></p>
      </header>
      <aside class="archive-note" aria-label="About this archive">
        <p>This earlier topic has been revised to remove unsupported result claims and health protocols. It offers general reflection prompts. It is not clinical guidance or an individual training, nutrition or sleep plan.</p>
      </aside>
      <div class="article-content"><Content /></div>
      <footer class="article-footer">
        <p>For current services and their limits, <a href="/terms">read the coaching scope</a> or <a href="/#contact">request a conversation with Edgar</a>.</p>
        <a href="/blog/">← All archived topics</a>
      </footer>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .article-main { padding: 7rem 1.25rem 5rem; color: var(--color-ink); background: var(--color-page); }
  .article-inner { max-width: 46rem; margin-inline: auto; }
  .breadcrumb { display: flex; flex-wrap: wrap; gap: .65rem; font-size: .85rem; margin-bottom: 3rem; }
  .breadcrumb span { color: var(--color-muted); }
  .page-kicker { color: var(--color-action); font-size: .75rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: 1rem 0 1.25rem; font-size: clamp(2.4rem, 6vw, 4rem); font-weight: 500; line-height: 1.1; letter-spacing: -.04em; }
  .article-intro { font-size: clamp(1.1rem, 2vw, 1.3rem); line-height: 1.7; color: var(--color-muted); }
  .article-date { margin-top: 1.25rem; font-size: .85rem; color: var(--color-muted); }
  .archive-note { margin-block: 2rem 3rem; padding: 1.25rem 1.5rem; background: var(--color-panel); font-size: .9rem; line-height: 1.75; color: var(--color-muted); }
  .article-content :global(h2) { font-size: 1.45rem; font-weight: 500; line-height: 1.35; letter-spacing: -.02em; margin: 2.5rem 0 1rem; }
  .article-content :global(p), .article-content :global(li) { color: var(--color-muted); line-height: 1.85; }
  .article-content :global(p + p) { margin-top: 1rem; }
  .article-content :global(ul) { list-style: disc; padding-left: 1.25rem; margin-block: 1.25rem; }
  .article-content :global(li + li) { margin-top: .65rem; }
  .article-content :global(a), a { color: var(--color-action); text-decoration: underline; text-underline-offset: .2em; }
  a:hover { text-decoration-thickness: 2px; }
  .article-footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-panel); font-size: .95rem; line-height: 1.8; }
  .article-footer p { color: var(--color-muted); margin-bottom: 1.5rem; }
</style>
