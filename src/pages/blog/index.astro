---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<Layout
  title="Article archive | Coach Edgar"
  description="Earlier Coach Edgar topics, retained as a short archive with updated scope and links to the current coaching offer."
  noindex={true}
>
  <Navigation />
  <main id="main-content" class="archive-main">
    <div class="archive-inner">
      <header>
        <p class="page-kicker">Coach Edgar · Article archive</p>
        <h1>Earlier topics.<br />A clearer scope.</h1>
        <p class="page-intro">This archive keeps earlier article links useful. The topics have been edited into general reflections on everyday habits, without the previous claims about results or personalized health protocols.</p>
        <p class="archive-note">These pages are not clinical guidance or a description of what a coaching program includes. <a href="/terms">Read the current coaching scope</a>.</p>
      </header>

      <section class="article-list" aria-label="Archived topics">
        {posts.map((post) => (
          <article>
            <p class="article-date">Originally published <time datetime={post.data.publishDate.toISOString()}>{post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time></p>
            <h2><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h2>
            <p>{post.data.excerpt}</p>
            <a class="article-link" href={`/blog/${post.slug}/`}>Read the archived topic <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </section>

      <div class="current-offer">
        <h2>Looking for the current coaching offer?</h2>
        <p>Explore Coach Edgar — Health &amp; Performance, or request a conversation about your goals.</p>
        <a href="/#coaching">Explore coaching</a>
        <a href="/#contact">Request a call</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .archive-main { padding: clamp(7rem, 12vw, 10rem) 1.25rem 5rem; color: var(--color-ink); background: var(--color-page); }
  .archive-inner { max-width: 56rem; margin-inline: auto; }
  .page-kicker { color: var(--color-action); font-size: .8rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin: 1.1rem 0 1.5rem; font-size: clamp(2.75rem, 8vw, 5rem); font-weight: 500; line-height: 1.06; letter-spacing: -.045em; }
  .page-intro { max-width: 42rem; font-size: clamp(1.1rem, 2vw, 1.3rem); line-height: 1.7; color: var(--color-muted); }
  .archive-note { max-width: 42rem; margin-top: 1.5rem; font-size: .95rem; line-height: 1.7; color: var(--color-muted); }
  .article-list { margin-top: 3rem; border-top: 1px solid var(--color-panel); }
  article { padding-block: 2rem; border-bottom: 1px solid var(--color-panel); }
  .article-date { font-size: .8rem; color: var(--color-muted); margin-bottom: .7rem; }
  h2 { font-size: clamp(1.4rem, 3vw, 1.8rem); font-weight: 500; line-height: 1.3; letter-spacing: -.02em; margin-bottom: .8rem; }
  article h2 a { color: var(--color-ink); text-decoration: none; }
  article p:not(.article-date) { max-width: 43rem; line-height: 1.75; color: var(--color-muted); }
  a { color: var(--color-action); text-decoration: underline; text-underline-offset: .2em; }
  a:hover { text-decoration-thickness: 2px; }
  .article-link { display: inline-block; margin-top: 1rem; font-size: .95rem; }
  .current-offer { margin-top: 3rem; padding: clamp(1.5rem, 4vw, 2.5rem); background: var(--color-panel); }
  .current-offer p { line-height: 1.75; color: var(--color-muted); margin-bottom: 1.2rem; }
  .current-offer a { display: inline-block; margin: .25rem 1.5rem .25rem 0; }
</style>
